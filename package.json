{
  "name": "@umituz/web-traffic",
  "version": "1.0.4",
  "description": "Web analytics tracking library. Event tracking, pageviews, sessions, device info, and UTM parameter support.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tracking": {
      "types": "./dist/domains/tracking/index.d.ts",
      "default": "./dist/domains/tracking/index.js"
    },
    "./conversion": {
      "types": "./dist/domains/conversion/index.d.ts",
      "default": "./dist/domains/conversion/index.js"
    },
    "./analytics": {
      "types": "./dist/domains/analytics/index.d.ts",
      "default": "./dist/domains/analytics/index.js"
    },
    "./affiliate": {
      "types": "./dist/domains/affiliate/index.d.ts",
      "default": "./dist/domains/affiliate/index.js"
    },
    "./infrastructure": {
      "types": "./dist/infrastructure/index.d.ts",
      "default": "./dist/infrastructure/index.js"
    },
    "./presentation": {
      "types": "./dist/presentation/index.d.ts",
      "default": "./dist/presentation/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'Lint passed'",
    "prepublishOnly": "npm run build",
    "version:patch": "npm version patch -m 'chore: release v%s'",
    "version:minor": "npm version minor -m 'chore: release v%s'",
    "version:major": "npm version major -m 'chore: release v%s'"
  },
  "keywords": [
    "web",
    "analytics",
    "tracking",
    "ddd",
    "domain-driven-design",
    "pageview",
    "events",
    "utm",
    "session",
    "conversion",
    "aggregates",
    "value-objects"
  ],
  "author": "umituz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/umituz/web-traffic"
  },
  "peerDependencies": {
    "react": ">=18.2.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "react": "19.1.0",
    "typescript": "~5.9.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
